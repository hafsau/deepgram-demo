{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3432",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3432/", "http://localhost:3432/live", "http://localhost:3432/console/keys", "http://localhost:3432/console/usage", "http://localhost:3432/cosmos", "http://localhost:3432/notes"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-reports" }
  }
}
